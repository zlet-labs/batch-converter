<Window x:Class="Zlet.FolderConverter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Zlet.FolderConverter.App"
        mc:Ignorable="d"
        Title="Zlet Batch Converter v0.0.1"
        Icon="Assets/ZletBatchConverter.ico"
        Width="1280"
        Height="780"
        MinWidth="900"
        MinHeight="540"
        Background="{StaticResource PageBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>

    <Grid ClipToBounds="True">
        <Ellipse Width="520"
                 Height="360"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Margin="-210,-190,0,0"
                 Fill="#332D5BFF"
                 IsHitTestVisible="False">
            <Ellipse.Effect>
                <BlurEffect Radius="90" />
            </Ellipse.Effect>
        </Ellipse>
        <Ellipse Width="460"
                 Height="300"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 Margin="0,0,-180,-180"
                 Fill="#2420B8FF"
                 IsHitTestVisible="False">
            <Ellipse.Effect>
                <BlurEffect Radius="100" />
            </Ellipse.Effect>
        </Ellipse>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="2,0,2,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static local:ProductIdentity.Name}"
                                   FontSize="27"
                                   FontWeight="SemiBold" />
                        <Border Margin="12,3,0,0"
                                Padding="8,3"
                                CornerRadius="8"
                                Background="#4338CA"
                                VerticalAlignment="Top">
                            <TextBlock FontSize="12" FontWeight="Bold">
                                <Run Text="PRE-ALPHA · v" />
                                <Run Text="{x:Static local:ProductIdentity.Version}" />
                            </TextBlock>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Массовое преобразование файлов в папках и подпапках"
                               Margin="0,4,0,0"
                               FontSize="14"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
                <Border Grid.Column="1"
                        Style="{StaticResource PrivacyBadgeStyle}"
                        VerticalAlignment="Center">
                    <TextBlock Text="●  Локально · Файлы не отправляются в интернет"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#B9F4FF" />
                </Border>
            </Grid>

            <Border Grid.Row="1"
                    Style="{StaticResource GlassPanelStyle}"
                    Margin="0,0,0,12"
                    Padding="14,11">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="26"
                            Height="26"
                            CornerRadius="13"
                            Background="#2D5BFF"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0">
                        <TextBlock Text="1"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold" />
                    </Border>

                    <Grid Grid.Column="1" Margin="0,0,10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox Text="{Binding SelectedFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{Binding SelectedFolder}"
                                 Height="42"
                                 Padding="11,0"
                                 VerticalContentAlignment="Center"
                                 IsEnabled="{Binding CanChangeSettings}"
                                 KeyDown="SourcePathTextBox_KeyDown" />
                        <TextBlock Grid.Row="1"
                                   Text="{Binding SourcePathError}"
                                   Foreground="#FF9AAA"
                                   FontSize="12"
                                   Margin="2,3,0,0"
                                   Visibility="{Binding HasSourcePathError, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Grid>

                    <Button Grid.Column="2"
                            Content="Копировать"
                            Style="{StaticResource CompactButtonStyle}"
                            ToolTip="Копировать полный путь"
                            Margin="0,0,10,0"
                            IsEnabled="{Binding CanCopySelectedFolder}"
                            Click="CopyFolderButton_Click" />

                    <Button Grid.Column="3"
                            Content="Обзор"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,10,0"
                            IsEnabled="{Binding CanChangeSettings}"
                            Click="ChooseFolderButton_Click" />

                    <CheckBox Grid.Column="4"
                              Content="Включать подпапки"
                              Style="{StaticResource ToggleSwitchStyle}"
                              IsChecked="{Binding IncludeSubfolders}"
                              Margin="0,0,12,0"
                              IsEnabled="{Binding CanChangeSettings}" />

                    <Button Grid.Column="5"
                            Content="Найти файлы"
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsEnabled="{Binding CanScan}"
                            Click="ScanButton_Click" />
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" MinWidth="280" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" MinWidth="400" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource GlassPanelStyle}"
                        Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="14,12,14,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="26"
                                    Height="26"
                                    CornerRadius="13"
                                    Background="#6D4AFF"
                                    Margin="0,0,9,0">
                                <TextBlock Text="2"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontWeight="Bold" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Правила"
                                           FontSize="17"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Одно действие для каждого формата"
                                           FontSize="14"
                                           Foreground="{StaticResource TextTertiaryBrush}" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1">
                            <TextBlock Text="После сканирования здесь появятся найденные форматы."
                                       Margin="16"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       Visibility="{Binding HasRules, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                            <DataGrid ItemsSource="{Binding FormatRules}"
                                      AutoGenerateColumns="False"
                                      HeadersVisibility="Column"
                                      BorderThickness="0"
                                      RowHeight="52"
                                      RowDetailsVisibilityMode="Visible"
                                      IsReadOnly="True"
                                      Visibility="{Binding HasRules, Converter={StaticResource BoolToVisibilityConverter}}">
                                <DataGrid.RowDetailsTemplate>
                                    <DataTemplate>
                                        <Border Margin="12,-5,12,8"
                                                Padding="10,6"
                                                CornerRadius="6"
                                                Background="#6B17243A"
                                                Visibility="{Binding HasExtensionBreakdown, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{Binding ExtensionBreakdown}"
                                                       ToolTip="{Binding ExtensionBreakdown}"
                                                       FontSize="14"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap" />
                                        </Border>
                                    </DataTemplate>
                                </DataGrid.RowDetailsTemplate>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Формат" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center"
                                                            Margin="12,0,0,0">
                                                    <TextBlock Text="{Binding FormatLabel}"
                                                               FontWeight="SemiBold" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Найден" Width="72">
                                        <DataGridTemplateColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader"
                                                   BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                <Setter Property="Padding" Value="8,0" />
                                            </Style>
                                        </DataGridTemplateColumn.HeaderStyle>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Count}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           TextAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Что делать" Width="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding Targets}"
                                                          SelectedItem="{Binding SelectedTarget, Mode=TwoWay}"
                                                          IsEnabled="{Binding DataContext.CanChangeSettings, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          MinWidth="112">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Label}" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="2"
                        Style="{StaticResource GlassPanelStyle}"
                        Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Margin="14,12,14,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="26"
                                    Height="26"
                                    CornerRadius="13"
                                    Background="#228BF4"
                                    Margin="0,0,9,0">
                                <TextBlock Text="3"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontWeight="Bold" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Preview операций"
                                           FontSize="17"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding StateMessage}"
                                           FontSize="14"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <ComboBox Grid.Column="2"
                                      Width="172"
                                      ItemsSource="{Binding PreviewFilters}"
                                      SelectedItem="{Binding SelectedPreviewFilter}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <Border Grid.Row="1"
                                Background="#670A1323"
                                BorderBrush="#16243A"
                                BorderThickness="0,1"
                                Padding="14,8">
                            <UniformGrid Columns="6">
                                <StackPanel>
                                    <TextBlock Text="Найдено" Style="{StaticResource MetricLabelStyle}" />
                                    <TextBlock Text="{Binding FoundCount}" Style="{StaticResource MetricValueStyle}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Преобразуем" Style="{StaticResource MetricLabelStyle}" />
                                    <TextBlock Text="{Binding ReadyCount}" Style="{StaticResource MetricValueStyle}" Foreground="#70E4FF" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Не трогаем" Style="{StaticResource MetricLabelStyle}" />
                                    <TextBlock Text="{Binding SkippedCount}" Style="{StaticResource MetricValueStyle}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Недоступно" Style="{StaticResource MetricLabelStyle}" />
                                    <TextBlock Text="{Binding UnavailableCount}" Style="{StaticResource MetricValueStyle}" Foreground="#FFD37A" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Конфликты" Style="{StaticResource MetricLabelStyle}" />
                                    <TextBlock Text="{Binding ConflictCount}" Style="{StaticResource MetricValueStyle}" Foreground="#FBBF72" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Ошибки" Style="{StaticResource MetricLabelStyle}" />
                                    <TextBlock Text="{Binding ErrorCount}" Style="{StaticResource MetricValueStyle}" Foreground="#FF8E9E" />
                                </StackPanel>
                            </UniformGrid>
                        </Border>

                        <Border Grid.Row="2"
                                Background="#470A1323"
                                BorderBrush="#16243A"
                                BorderThickness="0,0,0,1"
                                Padding="14,7"
                                Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibilityConverter}}">
                            <DockPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <TextBlock Text="{Binding CopyListStatus}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,14,0"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding SelectionSummary}"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               Foreground="#70E4FF" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Выбрать все"
                                            Style="{StaticResource CompactButtonStyle}"
                                            Margin="0,0,8,0"
                                            IsEnabled="{Binding CanChangeSettings}"
                                            Click="SelectAllButton_Click" />
                                    <Button Content="Снять выбор"
                                            Style="{StaticResource CompactButtonStyle}"
                                            Margin="0,0,8,0"
                                            IsEnabled="{Binding CanChangeSettings}"
                                            Click="ClearSelectionButton_Click" />
                                    <Button Content="Инвертировать"
                                            Style="{StaticResource CompactButtonStyle}"
                                            Margin="0,0,8,0"
                                            IsEnabled="{Binding CanChangeSettings}"
                                            Click="InvertSelectionButton_Click" />
                                    <Button Content="Копировать список"
                                            Style="{StaticResource CompactButtonStyle}"
                                            IsEnabled="{Binding CanCopyConversionList}"
                                            Click="CopyConversionListButton_Click" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="3"
                                Margin="12,10,12,0"
                                Padding="14,10"
                                CornerRadius="8"
                                Background="#5520334D"
                                BorderBrush="#36527A"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Office"
                                           Width="44"
                                           Height="24"
                                           Margin="0,0,10,0"
                                           TextAlignment="Center"
                                           FontWeight="Bold"
                                           Foreground="#70E4FF" />
                                <WrapPanel Grid.Column="1"
                                           VerticalAlignment="Center">
                                    <TextBlock Text="{Binding WordOfficeStatus}"
                                               Margin="0,0,18,0"
                                               FontSize="14"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ExcelOfficeStatus}"
                                               Margin="0,0,18,0"
                                               FontSize="14"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding PowerPointOfficeStatus}"
                                               FontSize="14"
                                               FontWeight="SemiBold" />
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="4">
                            <TextBlock Text="{Binding EmptyStateMessage}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="24"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       Visibility="{Binding HasPreview, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

                            <DataGrid ItemsSource="{Binding VisibleOperations}"
                                      AutoGenerateColumns="False"
                                      BorderThickness="0"
                                      Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibilityConverter}}">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="42">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          IsEnabled="{Binding CanSelect}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Исходный файл" Width="1.5*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding FilePath}"
                                                           ToolTip="{Binding SourcePath}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Размер"
                                                        Binding="{Binding FileSizeText}"
                                                        Width="82" />
                                    <DataGridTextColumn Header="Действие"
                                                        Binding="{Binding ActionLabel}"
                                                        Width="145" />
                                    <DataGridTemplateColumn Header="Результат" Width="1.25*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ResultPath}"
                                                           ToolTip="{Binding TargetPath}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Статус" Width="220">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="10"
                                                        Padding="10,4"
                                                        MinHeight="28"
                                                        HorizontalAlignment="Left"
                                                        ToolTip="{Binding Message}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource NeutralStatusBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding StatusTone}" Value="Warning">
                                                                    <Setter Property="Background" Value="{StaticResource WarningStatusBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusTone}" Value="Danger">
                                                                    <Setter Property="Background" Value="{StaticResource DangerStatusBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusTone}" Value="Success">
                                                                    <Setter Property="Background" Value="{StaticResource SuccessStatusBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusTone}" Value="InProgress">
                                                                    <Setter Property="Background" Value="{StaticResource InProgressStatusBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusTone}" Value="Ready">
                                                                    <Setter Property="Background" Value="{StaticResource ReadyStatusBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusTone}" Value="Cancelled">
                                                                    <Setter Property="Background" Value="{StaticResource CancelledStatusBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Status}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="200" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Время"
                                                        Binding="{Binding ExecutionTimeText}"
                                                        Width="72" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <Border Grid.Row="5"
                                Margin="12"
                                Padding="12"
                                CornerRadius="8"
                                Background="#9920334D"
                                BorderBrush="#36527A"
                                BorderThickness="1"
                                Visibility="{Binding HasFinalReport, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding FinalReportTitle}"
                                               FontWeight="SemiBold" />
                                    <WrapPanel Margin="0,5,0,0">
                                        <TextBlock Text="{Binding FinalConverted, StringFormat=Преобразовано: {0}}" Margin="0,0,14,0" />
                                        <TextBlock Text="{Binding FinalCopied, StringFormat=Скопировано: {0}}" Margin="0,0,14,0" />
                                        <TextBlock Text="{Binding FinalFailed, StringFormat=Ошибок: {0}}" Margin="0,0,14,0" />
                                        <TextBlock Text="{Binding FinalConflicts, StringFormat=Конфликтов: {0}}" Margin="0,0,14,0" />
                                        <TextBlock Text="{Binding FinalUnavailable, StringFormat=Недоступно: {0}}" Margin="0,0,14,0" />
                                        <TextBlock Text="{Binding FinalSkipped, StringFormat=Пропущено: {0}}" />
                                        <TextBlock Text="{Binding FinalNotSelected, StringFormat=Не выбрано: {0}}" Margin="14,0,0,0" />
                                        <TextBlock Text="{Binding FinalDurationText}" Margin="14,0,0,0" FontWeight="SemiBold" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding ResultFolder}"
                                               ToolTip="{Binding ResultFolder}"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextTertiaryBrush}"
                                               FontSize="14"
                                               Margin="0,4,0,0" />
                                    <Border Margin="0,8,0,0"
                                            Padding="10,8"
                                            CornerRadius="6"
                                            Background="#33FF647C"
                                            BorderBrush="#88FF647C"
                                            BorderThickness="1"
                                            Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="Ошибки по файлам"
                                                       FontWeight="SemiBold"
                                                       Foreground="#FFB4BE" />
                                            <ScrollViewer MaxHeight="96"
                                                          Margin="0,4,0,0"
                                                          VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding ErrorMessages}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}"
                                                                       Margin="0,2,0,0"
                                                                       TextWrapping="Wrap"
                                                                       Foreground="#FFD7DC"
                                                                       ToolTip="{Binding}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="{Binding ResultActionText}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="12,0,0,0"
                                        MinWidth="190"
                                        VerticalAlignment="Center"
                                        IsEnabled="{Binding CanOpenResult}"
                                        Click="OpenResultButton_Click" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="3"
                    Style="{StaticResource GlassPanelStyle}"
                    Margin="0,12,0,0"
                    Padding="14,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="132" />
                        <ColumnDefinition Width="106" />
                        <ColumnDefinition Width="205" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Width="130"
                              Height="42"
                              VerticalAlignment="Top"
                              ItemsSource="{Binding OutputModes}"
                              SelectedItem="{Binding SelectedOutputModeOption}"
                              IsEnabled="{Binding CanChangeSettings}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Grid Grid.Column="1" Margin="10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox Text="{Binding OutputPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{Binding OutputPath}"
                                 Height="42"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"
                                 IsEnabled="{Binding CanChangeSettings}" />
                        <TextBlock Grid.Row="1"
                                   Text="{Binding OutputPathError}"
                                   Foreground="#FF9AAA"
                                   FontSize="12"
                                   Margin="2,3,0,0"
                                   Visibility="{Binding HasOutputPathError, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Grid>
                    <Button Grid.Column="2"
                            Content="{Binding OutputBrowseButtonText}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,8,0"
                            VerticalAlignment="Top"
                            IsEnabled="{Binding CanChangeSettings}"
                            Click="ChooseOutputButton_Click" />
                    <Button Grid.Column="3"
                            Content="Сбросить"
                            Style="{StaticResource CompactButtonStyle}"
                            Margin="0,0,10,0"
                            VerticalAlignment="Top"
                            IsEnabled="{Binding CanChangeSettings}"
                            Click="ResetOutputButton_Click" />
                    <StackPanel Grid.Column="4"
                                VerticalAlignment="Top">
                        <Button Content="{Binding ConvertButtonText}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                MinWidth="205"
                                IsEnabled="{Binding CanConvert}"
                                Click="ConvertButton_Click" />
                        <TextBlock Text="{Binding SelectionSummary}"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource TextTertiaryBrush}" />
                    </StackPanel>
                    <Border Grid.Row="1"
                            Grid.ColumnSpan="5"
                            Margin="0,10,0,0"
                            Padding="12,10"
                            CornerRadius="8"
                            Background="#99132136"
                            BorderBrush="#36527A"
                            BorderThickness="1"
                            Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Преобразование"
                                       FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ProgressCountText}"
                                       Margin="16,0,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding ProgressPercentText}"
                                       Margin="16,0,0,0"
                                       FontWeight="Bold"
                                       Foreground="#70E4FF" />
                            <Button Grid.Column="3"
                                    Content="{Binding StopButtonText}"
                                    Style="{StaticResource CompactButtonStyle}"
                                    Margin="16,-4,0,-4"
                                    MinWidth="112"
                                    IsEnabled="{Binding CanStop}"
                                    Click="StopButton_Click" />
                            <ProgressBar Grid.Row="1"
                                         Grid.ColumnSpan="4"
                                         Height="8"
                                         Margin="0,7,0,7"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding ProgressPercent, Mode=OneWay}" />
                            <TextBlock Grid.Row="2"
                                       Text="{Binding CurrentFile, StringFormat=Файл: {0}}"
                                       ToolTip="{Binding CurrentFile}"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Grid.Row="2"
                                       Grid.Column="1"
                                       Text="{Binding ElapsedTimeText}"
                                       Margin="16,0,0,0"
                                       Foreground="{StaticResource TextTertiaryBrush}" />
                            <TextBlock Grid.Row="2"
                                       Grid.Column="2"
                                       Text="{Binding RemainingTimeText}"
                                       Margin="16,0,0,0"
                                       Foreground="{StaticResource TextTertiaryBrush}" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
