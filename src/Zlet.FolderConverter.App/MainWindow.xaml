<Window x:Class="Zlet.FolderConverter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Zlet Folder Converter"
        Height="720"
        MinHeight="560"
        Width="1120"
        MinWidth="920">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Zlet Folder Converter"
                       FontSize="24"
                       FontWeight="SemiBold" />
            <TextBlock Text="Работает локально, без установки офисных программ"
                       Margin="0,4,0,0"
                       Foreground="#555555" />
        </StackPanel>

        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="Выбрать папку"
                    Width="130"
                    Margin="0,0,8,0"
                    Click="ChooseFolderButton_Click" />
            <TextBox Grid.Column="1"
                     Text="{Binding SelectedFolder}"
                     IsReadOnly="True"
                     VerticalContentAlignment="Center"
                     Margin="0,0,8,0" />
            <CheckBox Grid.Column="2"
                      Content="Обрабатывать подпапки"
                      IsChecked="{Binding IncludeSubfolders}"
                      VerticalAlignment="Center"
                      Margin="0,0,12,0" />
            <Button Grid.Column="3"
                    Content="Сканировать"
                    Width="120"
                    IsEnabled="{Binding CanScan}"
                    Click="ScanButton_Click" />
        </Grid>

        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding DocCount, StringFormat=DOC: {0}}"
                       FontWeight="SemiBold"
                       Margin="0,0,20,0" />
            <TextBlock Grid.Column="1"
                       Text="{Binding XlsCount, StringFormat=XLS: {0}}"
                       FontWeight="SemiBold"
                       Margin="0,0,20,0" />
            <TextBlock Grid.Column="2"
                       Text="{Binding PptCount, StringFormat=PPT: {0}}"
                       FontWeight="SemiBold"
                       Margin="0,0,20,0" />
            <TextBlock Grid.Column="3"
                       Text="{Binding StateMessage}"
                       Foreground="#555555" />
        </Grid>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="160" />
            </Grid.RowDefinitions>

            <GroupBox Header="Preview planned operations"
                      Grid.Row="0"
                      Margin="0,0,0,12">
                <Grid>
                    <TextBlock Text="{Binding EmptyStateMessage}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#666666" />
                    <DataGrid ItemsSource="{Binding Operations}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Source" Binding="{Binding RelativePath}" Width="2*" />
                            <DataGridTextColumn Header="Target" Binding="{Binding TargetPath}" Width="3*" />
                            <DataGridTextColumn Header="Source format" Binding="{Binding SourceFormat}" Width="Auto" />
                            <DataGridTextColumn Header="Target format" Binding="{Binding TargetFormat}" Width="Auto" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto" />
                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="3*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>

            <GroupBox Header="Errors and notices"
                      Grid.Row="1">
                <ListBox ItemsSource="{Binding ErrorMessages}" />
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
