<Window x:Class="Zlet.FolderConverter.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource SettingsTitle}" Width="390" Height="230"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="#0D1728" Foreground="#F2F6FF">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="{DynamicResource SettingsTitle}" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" Text="{DynamicResource LanguageLabel}" Margin="0,24,0,8" FontWeight="SemiBold"/>
        <StackPanel Grid.Row="2">
            <RadioButton x:Name="RussianButton" Content="{DynamicResource LanguageRussian}" Margin="0,7" Checked="Language_Checked" Tag="ru-RU"/>
            <RadioButton x:Name="EnglishButton" Content="{DynamicResource LanguageEnglish}" Margin="0,7" Checked="Language_Checked" Tag="en-US"/>
        </StackPanel>
        <TextBlock x:Name="SaveErrorText" Grid.Row="3" Text="{DynamicResource SettingsSaveFailed}"
                   Foreground="#FF9AAA" Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
    </Grid>
</Window>
